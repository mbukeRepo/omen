# Turnkey signer (production path — every order is a Turnkey signing activity)
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
# Wallet account address (0x...) or Turnkey private key id to sign with
TURNKEY_SIGN_WITH=

# Dev-only fallback signer, used when the Turnkey vars above are not set
# HL_PRIVATE_KEY=0x...

# Hyperliquid network
HL_TESTNET=false
# HL_API_URL=https://api.hyperliquid.xyz
