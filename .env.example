# Turnkey signer (production path — every order is a Turnkey signing activity)
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
# Wallet account address (0x...) or Turnkey private key id to sign with
TURNKEY_SIGN_WITH=

# Signer selection: "turnkey" | "local"; unset = auto (Turnkey when configured, else local)
# SIGNER=local

# Local viem wallet (hot-wallet grade — use Turnkey for real funds).
# Either a raw private key (generate one with `hip4 wallet new --save`) …
# WALLET_PRIVATE_KEY=0x...
# … or a mnemonic + HD account index:
# WALLET_MNEMONIC=test test test ...
# WALLET_ACCOUNT_INDEX=0

# Hyperliquid network
HL_TESTNET=false
# HL_API_URL=https://api.hyperliquid.xyz
# HyperEVM JSON-RPC for `book --rpc` (direct HyperCore reads via precompiles)
# HL_EVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Telegram channel alerts for `hip4 watch` (optional; console-only when unset).
# Bot must be an admin of the channel; chat id is e.g. @mychannel or -100xxxxxxxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default whitelist for `hip4 watch` (comma-separated): outcome indices,
# app.hyperliquid.xyz trade URLs, and/or name patterns (substring match).
# WATCH_WHITELIST=https://app.hyperliquid.xyz/trade/btc-above-82334-yes-oct-10-0600,sportsContestWinner: NFL
