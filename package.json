{
  "name": "hip4-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for Hyperliquid HIP-4 outcome markets, signing with a Turnkey wallet",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hip4": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "hip4": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.3",
    "@turnkey/sdk-server": "^8.6.0",
    "@turnkey/viem": "^0.14.45",
    "commander": "^14.0.1",
    "dotenv": "^16.4.7",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
