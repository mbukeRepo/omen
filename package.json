{
  "name": "@mbukerepo/hip4-cli",
  "version": "0.1.0",
  "description": "CLI for Hyperliquid HIP-4 outcome markets: trading, Telegram watching, and Kronos forecasts, signing with Turnkey or local wallets",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbukeRepo/omen.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "hip4": "dist/cli.js"
  },
  "files": [
    "dist",
    "kronos/forecast.py",
    "kronos/backtest.py",
    "kronos/setup.sh",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "hip4": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.3",
    "@turnkey/sdk-server": "^8.6.0",
    "@turnkey/viem": "^0.14.45",
    "commander": "^14.0.1",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
